NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/canchas

# Clave para firmar los JWT. Es obligatoria: el servidor no arranca sin ella.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# Pasarela de pagos: "sandbox" (simulada) o "mercadopago".
PAYMENT_PROVIDER=sandbox

# Solo si PAYMENT_PROVIDER=mercadopago. Usar un token TEST-, nunca uno de produccion.
MERCADO_PAGO_ACCESS_TOKEN=

# Clave secreta del webhook de Mercado Pago (panel de la aplicacion > Webhooks).
# Si se define, se valida la firma x-signature de cada notificacion. Si queda
# vacia, la validacion se omite (solo recomendado en desarrollo).
MERCADO_PAGO_WEBHOOK_SECRET=

# Origen del frontend, usado para armar los links de retorno del pago.
WEB_BASE_URL=http://localhost:5173

# Origenes permitidos por CORS, separados por coma. Si se omite, se permite
# unicamente WEB_BASE_URL. En produccion listar el/los dominios reales.
CORS_ORIGINS=

# Numero de saltos de proxy a confiar para leer la IP real (X-Forwarded-For).
# Sin valor, Express no confia en el proxy. Detras de Nginx/Cloudflare: 1.
TRUST_PROXY=

# URL de Redis para compartir el store de rate limiting entre instancias
# (ej: redis://127.0.0.1:6379). Si queda vacia se usa el store en memoria.
REDIS_URL=

# Minutos que una reserva "pendiente" mantiene el cupo antes de cancelarse sola.
PENDING_TTL_MINUTES=15

# Porcentaje del total que se cobra como sena al elegir pago parcial.
DEPOSIT_PERCENT=50

# Horas minimas de anticipacion para que el cliente pueda cancelar.
CANCEL_WINDOW_HOURS=4

# Notificaciones transaccionales por email (nodemailer/SMTP). Si SMTP_HOST
# queda vacio, el envio de comprobantes se deshabilita y solo se registra un log.
SMTP_HOST=
SMTP_PORT=587
# "true" para conexion TLS implicita (puerto 465). Para 587 suele ir "false".
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Copa 5 <no-reply@copa5.local>
# Responder a (opcional). Si se omite, las respuestas van a MAIL_FROM.
MAIL_REPLY_TO=

# Limite de peticiones por IP. Las ventanas son fijas: auth = 1 min, reservas = 15 min.
AUTH_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_MAX=10
